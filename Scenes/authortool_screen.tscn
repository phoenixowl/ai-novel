[connection signal="pressed" from="RootMargin/RootBox/HeaderBox/BackBtn" to="." method="_on_back_pressed"]
[connection signal="pressed" from="RootMargin/RootBox/BottomBox/ReloadBtn" to="." method="_on_reload_pressed"]
[connection signal="pressed" from="RootMargin/RootBox/BottomBox/ExportBtn" to="." method="_on_export_pressed"]
