[node name="BottomBox" type="HBoxContainer" parent="RootMargin/RootBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ReloadBtn" type="Button" parent="RootMargin/RootBox/BottomBox"]
unique_name_in_owner = true
layout_mode = 2
text = "重新载入草稿"

[node name="ExportBtn" type="Button" parent="RootMargin/RootBox/BottomBox"]
